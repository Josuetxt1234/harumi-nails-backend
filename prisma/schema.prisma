generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Users
model User {
  id        String  @id @default(uuid())
  firstName String
  lastName  String
  // Uniqueness for active rows only: see prisma/partial-unique-indexes.sql
  email     String
  phone     String?
  password  String
  isActive  Boolean @default(true)
  avatarUrl String?

  // Soft delete & base audit
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Audit relations on other users
  createdById  String?
  createdBy    User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdUsers User[]  @relation("UserCreatedBy")

  updatedById  String?
  updatedBy    User?   @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  updatedUsers User[]  @relation("UserUpdatedBy")

  deletedById  String?
  deletedBy    User?   @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  deletedUsers User[]  @relation("UserDeletedBy")

  roles    UserRole[]
  sessions Session[]

  // Audit actions performed by this user
  createdRoles Role[] @relation("RoleCreatedBy")
  updatedRoles Role[] @relation("RoleUpdatedBy")
  deletedRoles Role[] @relation("RoleDeletedBy")

  createdPermissions Permission[] @relation("PermissionCreatedBy")
  updatedPermissions Permission[] @relation("PermissionUpdatedBy")
  deletedPermissions Permission[] @relation("PermissionDeletedBy")

  assignedUserRoles UserRole[] @relation("UserRoleAssignedBy")
  revokedUserRoles  UserRole[] @relation("UserRoleRevokedBy")

  assignedRolePermissions RolePermission[] @relation("RolePermissionAssignedBy")
  revokedRolePermissions  RolePermission[] @relation("RolePermissionRevokedBy")

  createdSessions Session[] @relation("SessionCreatedBy")
  updatedSessions Session[] @relation("SessionUpdatedBy")
  deletedSessions Session[] @relation("SessionDeletedBy")

  mesaWorkRegisters    DailyRegister[] @relation("MesaWorkRegisters")
  createdWorkRegisters DailyRegister[] @relation("WorkRegisterCreatedBy")
  deletedWorkRegisters DailyRegister[] @relation("WorkRegisterDeletedBy")
  createdServices      Service[]       @relation("ServiceCreatedBy")
  updatedServices      Service[]       @relation("ServiceUpdatedBy")
  deletedServices      Service[]       @relation("ServiceDeletedBy")

  mesaAdvances     Advance[] @relation("MesaAdvances")
  createdAdvances  Advance[] @relation("AdvanceCreatedBy")
  cancelledAdvances Advance[] @relation("AdvanceCancelledBy")
  mesaPayrolls    Payroll[] @relation("MesaPayrolls")
  closedPayrolls  Payroll[] @relation("PayrollClosedBy")

  createdInventoryCategories InventoryCategory[] @relation("InventoryCategoryCreatedBy")
  updatedInventoryCategories InventoryCategory[] @relation("InventoryCategoryUpdatedBy")
  createdMaterials           Material[]          @relation("MaterialCreatedBy")
  updatedMaterials           Material[]          @relation("MaterialUpdatedBy")
  inventoryMovements         InventoryMovement[] @relation("InventoryMovementCreatedBy")

  @@index([email])
  @@index([isDeleted])
  @@index([isActive])
  @@index([isDeleted, isActive])
  @@map("users")
}

// 2. Roles
model Role {
  id          String  @id @default(uuid())
  // Uniqueness for active rows only: see prisma/partial-unique-indexes.sql
  name        String
  description String?

  // Soft delete & audit
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdById String?
  createdBy   User?   @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  updatedById String?
  updatedBy   User?   @relation("RoleUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  deletedById String?
  deletedBy   User?   @relation("RoleDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  users       UserRole[]
  permissions RolePermission[]

  @@index([name])
  @@index([isDeleted])
  @@map("roles")
}

// 3. Permissions
model Permission {
  id          String  @id @default(uuid())
  // Uniqueness for active rows only: see prisma/partial-unique-indexes.sql
  name        String
  description String?

  // Soft delete & audit
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdById String?
  createdBy   User?   @relation("PermissionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  updatedById String?
  updatedBy   User?   @relation("PermissionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  deletedById String?
  deletedBy   User?   @relation("PermissionDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  roles RolePermission[]

  @@index([name])
  @@index([isDeleted])
  @@map("permissions")
}

// 4. Junction: User <-> Role (assignment / revocation history)
// Active uniqueness (userId, roleId) WHERE isDeleted = false: see prisma/partial-unique-indexes.sql
// Preferred reassignment flow: reactivate the soft-deleted row (isDeleted = false) and bump updatedAt.
model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  // Soft delete & assignment audit
  isDeleted  Boolean   @default(false)
  assignedAt DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  assignedById String?
  assignedBy   User?   @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  revokedById String?
  revokedBy   User?   @relation("UserRoleRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([roleId])
  @@index([isDeleted])
  @@index([userId, isDeleted])
  @@index([roleId, isDeleted])
  @@map("user_roles")
}

// 5. Junction: Role <-> Permission (assignment / revocation history)
// Active uniqueness (roleId, permissionId) WHERE isDeleted = false: see prisma/partial-unique-indexes.sql
// Preferred reassignment flow: reactivate the soft-deleted row (isDeleted = false) and bump updatedAt.
model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  // Soft delete & assignment audit
  isDeleted  Boolean   @default(false)
  assignedAt DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  assignedById String?
  assignedBy   User?   @relation("RolePermissionAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  revokedById String?
  revokedBy   User?   @relation("RolePermissionRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@index([roleId])
  @@index([permissionId])
  @@index([isDeleted])
  @@index([roleId, isDeleted])
  @@index([permissionId, isDeleted])
  @@map("role_permissions")
}

// 6. Sessions (multi-device auth)
model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  isRevoked    Boolean  @default(false)

  // Soft delete & audit
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdById String?
  createdBy   User?   @relation("SessionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  updatedById String?
  updatedBy   User?   @relation("SessionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  deletedById String?
  deletedBy   User?   @relation("SessionDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([userId, isDeleted])
  @@index([userId, isRevoked])
  @@index([expiresAt])
  @@index([isDeleted])
  @@map("sessions")
}

// 7. Salon services catalog
model Service {
  id                   String    @id @default(uuid())
  name                 String
  category             String
  price                Decimal   @db.Decimal(10, 2)
  commissionPercentage Decimal   @default(50.00) @db.Decimal(5, 2)
  isActive             Boolean   @default(true)
  isDeleted            Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  createdById String?
  createdBy   User?   @relation("ServiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String?
  updatedBy   User?   @relation("ServiceUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedById String?
  deletedBy   User?   @relation("ServiceDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  items DailyRegisterDetail[]

  @@index([category])
  @@index([isDeleted])
  @@index([isActive])
  @@map("services")
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
}

// 8. Daily work registers
model DailyRegister {
  id              String        @id @default(uuid())
  clientName      String
  paymentMethod   PaymentMethod
  subtotalBase    Decimal       @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0.00) @db.Decimal(10, 2)
  cardFeeAmount   Decimal       @default(0.00) @db.Decimal(10, 2)
  totalPaid       Decimal       @db.Decimal(10, 2)
  totalCommission Decimal       @db.Decimal(10, 2)

  mesaUserId String
  mesaUser   User   @relation("MesaWorkRegisters", fields: [mesaUserId], references: [id], onDelete: Restrict)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdById String
  createdBy   User    @relation("WorkRegisterCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  deletedById String?
  deletedBy   User?   @relation("WorkRegisterDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payrollId String?
  payroll   Payroll? @relation(fields: [payrollId], references: [id], onDelete: Restrict)

  details DailyRegisterDetail[]

  @@index([mesaUserId])
  @@index([isDeleted])
  @@index([createdAt])
  @@index([paymentMethod])
  @@index([payrollId])
  @@map("daily_registers")
}

model DailyRegisterDetail {
  id              String        @id @default(uuid())
  dailyRegisterId String
  dailyRegister   DailyRegister @relation(fields: [dailyRegisterId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  unitPrice       Decimal       @db.Decimal(10, 2)
  commissionRate  Decimal       @db.Decimal(5, 2)
  quantity        Int           @default(1)
  lineSubtotal    Decimal       @db.Decimal(10, 2)
  lineCommission  Decimal       @db.Decimal(10, 2)

  @@index([dailyRegisterId])
  @@index([serviceId])
  @@map("daily_register_details")
}

enum AdvanceStatus {
  PENDING
  APPLIED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  CLOSED
  PAID
}

// 9. Cash advances (vales) for manicurists
model Advance {
  id         String        @id @default(uuid())
  mesaUserId String
  mesaUser   User          @relation("MesaAdvances", fields: [mesaUserId], references: [id], onDelete: Restrict)
  amount     Decimal       @db.Decimal(10, 2)
  reason     String?
  date       DateTime      @default(now())
  status     AdvanceStatus @default(PENDING)

  payrollId String?
  payroll   Payroll? @relation(fields: [payrollId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("AdvanceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  cancellationReason String?
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancelledBy        User?     @relation("AdvanceCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mesaUserId])
  @@index([status])
  @@index([date])
  @@index([payrollId])
  @@index([isDeleted])
  @@index([cancelledByUserId])
  @@index([mesaUserId, status, isDeleted])
  @@map("advances")
}

// 10. Weekly payroll for manicurists (Saturday 00:00 to Friday 23:59:59 salon TZ)
model Payroll {
  id                     String        @id @default(uuid())
  mesaUserId             String
  mesaUser               User          @relation("MesaPayrolls", fields: [mesaUserId], references: [id], onDelete: Restrict)
  periodStart            DateTime
  periodEnd              DateTime
  grossSales             Decimal       @db.Decimal(10, 2)
  baseCommissionTotal    Decimal       @db.Decimal(10, 2)
  weekendBonusTotal      Decimal       @db.Decimal(10, 2)
  advancesDeductionTotal Decimal       @db.Decimal(10, 2)
  netPayable             Decimal       @db.Decimal(10, 2)
  status                 PayrollStatus @default(DRAFT)
  closedAt               DateTime?
  closedById             String?
  closedBy               User?         @relation("PayrollClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  isDeleted              Boolean       @default(false)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  advances       Advance[]
  dailyRegisters DailyRegister[]

  @@index([mesaUserId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@index([mesaUserId, periodStart, periodEnd])
  @@index([isDeleted])
  @@index([closedById])
  @@map("payrolls")
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum MaterialUnit {
  UNIT
  ML
  GRAMS
  PAIR
  BOX
  BOTTLE
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
}

model InventoryCategory {
  id          String        @id @default(uuid())
  name        String        @unique
  description String?
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  createdById String?
  createdBy   User?   @relation("InventoryCategoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String?
  updatedBy   User?   @relation("InventoryCategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  materials Material[]

  @@index([status])
  @@map("inventory_categories")
}

model Material {
  id            String        @id @default(uuid())
  code          String        @unique
  name          String
  description   String?
  categoryId    String
  category      InventoryCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit          MaterialUnit
  currentStock  Decimal       @default(0) @db.Decimal(12, 2)
  minimumStock  Decimal       @default(0) @db.Decimal(12, 2)
  costPrice     Decimal       @default(0) @db.Decimal(12, 2)
  status        CatalogStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  createdById String?
  createdBy   User?   @relation("MaterialCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String?
  updatedBy   User?   @relation("MaterialUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  movements InventoryMovement[]

  @@index([categoryId])
  @@index([status])
  @@index([name])
  @@map("materials")
}

model InventoryMovement {
  id            String                 @id @default(uuid())
  materialId    String
  material      Material               @relation(fields: [materialId], references: [id], onDelete: Restrict)
  type          InventoryMovementType
  quantity      Decimal                @db.Decimal(12, 2)
  previousStock Decimal                @db.Decimal(12, 2)
  newStock      Decimal                @db.Decimal(12, 2)
  reason        String
  createdById   String
  createdBy     User                   @relation("InventoryMovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime               @default(now())

  @@index([materialId])
  @@index([type])
  @@index([createdAt])
  @@index([materialId, createdAt])
  @@map("inventory_movements")
}

enum NotificationType {
  VOUCHER_CREATED
  VOUCHER_CANCELLED
  SYSTEM
}

enum NotificationRole {
  SUPER_ADMIN
  ADMIN
  MESA
}

model Notification {
  id         String             @id @default(uuid())
  title      String
  message    String
  type       NotificationType
  isRead     Boolean            @default(false)
  targetRole NotificationRole   @default(SUPER_ADMIN)
  createdAt  DateTime           @default(now())

  @@index([isRead])
  @@index([targetRole])
  @@index([createdAt])
  @@index([targetRole, isRead, createdAt])
  @@map("notifications")
}
